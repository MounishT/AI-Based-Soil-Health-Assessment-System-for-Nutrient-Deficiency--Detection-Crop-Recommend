# ============================================================
# .env  —  AI-Based Soil Health Assessment System
# Copy from .env.example and fill in your actual values.
# ============================================================

# ── Application ────────────────────────────────────────────
APP_NAME="AI-Based Soil Health Assessment System"
APP_VERSION="1.0.0"
DEBUG=False

# ── Database (update password to match your pgAdmin4 setup) ─
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=soil_health_db

DB_ECHO=False

# ── File Storage ───────────────────────────────────────────
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10

# ── ML Models ──────────────────────────────────────────────
CROP_MODEL_PATH=models/crop_model.pkl
FERTILIZER_MODEL_PATH=models/fertilizer_model.pkl

# ── CORS ───────────────────────────────────────────────────
ALLOWED_ORIGINS=["*"]

# ── Weather API ───────────────────────────────────────────
OPENWEATHER_API_KEY=

# ── Authentication (JWT) ─────────────────────────────────
JWT_SECRET_KEY=soil-health-super-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── Logging ────────────────────────────────────────────────
LOG_LEVEL=INFO
