# ============================================================
# .env.example
# Copy this file to .env and fill in your actual values.
# Never commit your real .env to version control!
# ============================================================

# ── Application ────────────────────────────────────────────
APP_NAME="AI-Based Soil Health Assessment System"
APP_VERSION="1.0.0"
DEBUG=False

# ── Database ───────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password_here
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=soil_health_db

# Optional: override the full URL directly (leave blank to auto-build)
# DATABASE_URL=postgresql://postgres:password@localhost:5432/soil_health_db

# Log SQL statements (True for development only)
DB_ECHO=False

# ── File Storage ───────────────────────────────────────────
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10

# ── ML Models ──────────────────────────────────────────────
CROP_MODEL_PATH=models/crop_model.pkl
FERTILIZER_MODEL_PATH=models/fertilizer_model.pkl

# ── CORS ───────────────────────────────────────────────────
# Comma-separated list of allowed origins (use * for development only)
ALLOWED_ORIGINS=["*"]

# ── Logging ────────────────────────────────────────────────
LOG_LEVEL=INFO
